// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH.JS MODELS
// ============================================

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// APP MODELS
// ============================================

// Conversation represents a chat session
model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New Chat")
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// Message represents a single message in a conversation
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String // "user" or "assistant"
  content String @db.Text // Allow longer text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([createdAt])
}

// UserPreferences for storing user settings
model UserPreferences {
  id              String           @id @default(cuid())
  userId          String           @unique
  theme           String           @default("dark")
  sidebarExpanded Boolean          @default(true)
  fontSize        String           @default("medium")
  personality     PersonalityTrait @default(NEUTRAL)
  responseStyle   ResponseStyle    @default(BALANCED)
  customPrompt    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ============================================
// RAG DOCUMENT MODELS
// ============================================

// Document represents an uploaded file for RAG
model Document {
  id     String @id @default(cuid())
  userId String

  filename    String // Original filename
  fileType    String // pdf, docx, txt, md
  fileSize    Int // Size in bytes
  title       String? // User-editable title
  description String? // Optional description

  status       DocumentStatus @default(PENDING)
  chunkCount   Int            @default(0)
  pageCount    Int?
  errorMessage String? // Error details if processing failed

  chunks DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// DocumentChunk represents a chunk of text from a document stored in vector DB
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content    String  @db.Text // The actual text chunk
  chunkIndex Int // Order in document
  vectorId   String? // ID in Upstash Vector

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([vectorId])
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum PersonalityTrait {
  NEUTRAL
  FRIENDLY
  PROFESSIONAL
  HUMOROUS
  TECHNICAL
}

enum ResponseStyle {
  CONCISE
  BALANCED
  DETAILED
}

// ============================================
// AGENT TOOL MODELS
// ============================================

// Lead captured by the Digital Twin when a visitor shows interest
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String?  @db.Text
  source    String   @default("chat") // where the lead came from
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Meeting request captured by the Digital Twin's bookMeeting tool
model MeetingRequest {
  id            String   @id @default(cuid())
  name          String
  email         String
  preferredDate String? // free-text date/time preference from the visitor
  topic         String?  @db.Text
  status        String   @default("requested") // requested | scheduled | declined
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
